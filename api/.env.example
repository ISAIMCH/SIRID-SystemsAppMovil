NODE_ENV=development
PORT=3000
MONGO_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
QR_TOKEN_SECRET=replace_with_a_different_unique_random_secret_of_at_least_32_characters
# Obsoleta: cada torniquete usa su propia llave (dashboard → dispositivos). Esta solo se acepta durante la transición.
ADMIN_BOOTSTRAP_KEY=replace_with_a_long_random_one_time_setup_key
# Turn on only while creating the first Admin, then set back to false.
ENABLE_ADMIN_BOOTSTRAP=false
JWT_EXPIRES_IN=1h
QR_TOKEN_TTL_SECONDS=60
# Comma-separated web origins (e.g. the Admin dashboard). Required when NODE_ENV=production.
CORS_ORIGINS=
# Cloudflare R2 (documentos privados). Obligatorias en producción; sin ellas, en desarrollo los documentos responden 503.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Bucket PÚBLICO de R2 para GIFs y miniaturas del catálogo global (distinto de R2_BUCKET) y la URL pública
# desde la que se sirve (dominio propio o https://pub-xxxx.r2.dev). Van juntas; sin ellas se usa GitHub.
# Subir medios: npm run media:upload -- <ruta a exercises-dataset-main>
EXERCISES_MEDIA_BUCKET=
EXERCISES_MEDIA_PUBLIC_URL=
# Planes de GymGo que pagan los dueños (Stripe: tarjeta con renovación y OXXO). Van juntas.
# Modo de prueba: claves sk_test_ del Dashboard de Stripe (Desarrolladores → Claves de API).
# STRIPE_WEBHOOK_SECRET: el whsec_ del endpoint https://<api>/api/subscription/webhook (o el que imprime `stripe listen`).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# false si la cuenta de Stripe no tiene OXXO activado (solo cuentas de México).
STRIPE_ENABLE_OXXO=true
# PayPal Checkout (sandbox en la demo). La API captura y verifica cada orden con PayPal. Van juntas.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
